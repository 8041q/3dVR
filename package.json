{
  "name": "3dvr-self-hosted",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:https": "node scripts/dev.mjs --https",
    "dev:web": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "worker": "node server/panoramaWorker.js",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "start:web": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:repo && npm run test:assets && npm run test:migration",
    "test:repo": "node scripts/repo-check.mjs",
    "test:assets": "node scripts/asset-portability-smoke.mjs",
    "test:migration": "node scripts/migration-smoke.mjs",
    "export:project": "node scripts/export-project.mjs",
    "import:project": "node scripts/import-project.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.1.5"
  }
}
