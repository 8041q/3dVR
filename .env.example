PORT=3001
APP_ORIGIN=https://vr.example.com
# Local development: APP_ORIGIN=http://localhost:5173
# Optional additional exact HTTPS origins for a production installation.
# APP_TRUSTED_ORIGINS=https://exhibition.example.com
# Public hostnames configured on your reverse proxy (no fixed server IP needed).
# APP_PUBLIC_HOSTS=tours.example.com,exhibition.example.com
# Set 0 to accept only configured names instead of current machine addresses.
# APP_DYNAMIC_HOSTS=0
HOST=127.0.0.1
# Optional read-only secret file; otherwise storage/security/auth.secret
# AUTH_SECRET_FILE=/run/secrets/atria_auth
# Optional. Defaults to ./storage
# VR_STORAGE_ROOT=/srv/3dvr/storage
# Optional local MMDB database for device location. No IPs are sent to outside services.
# Defaults to the bundled DB-IP country snapshot; use a current country/city MMDB here.
# GEOIP_DATABASE=/srv/3dvr/geoip.mmdb
PANORAMA_WEBP_QUALITY=94
PANORAMA_WORKER_POLL_MS=1500
# Generic editor asset uploads are streamed to disk. A positive cap is always enforced.
MAX_ASSET_UPLOAD_BYTES=2147483648
# Whole-project ZIP imports (10 GiB uploaded, 20 GiB extracted).
MAX_PROJECT_IMPORT_BYTES=10737418240
MAX_PROJECT_EXTRACT_BYTES=21474836480
