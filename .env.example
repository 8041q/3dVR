# Copy this file to .env and fill in the values.
# Generate a password hash with: node -e "require('bcryptjs').hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_chars

PORT=3001
